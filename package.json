{
  "name": "@crinkl/verify",
  "version": "0.1.0-alpha.3",
  "description": "Verify Crinkl spend attestation tokens and reward commitments locally, with optional caller-directed chain RPC evidence.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "fixtures",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "author": "PriceChain Labs <support@crinkl.xyz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crinkl-protocol/crinkl-verify.git"
  },
  "homepage": "https://github.com/crinkl-protocol/crinkl-verify#readme",
  "bugs": {
    "url": "https://github.com/crinkl-protocol/crinkl-verify/issues"
  },
  "keywords": [
    "crinkl",
    "spend-attestation",
    "verification",
    "ed25519",
    "rfc8785"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:conformance": "npm run build && node --test test/*.conformance.test.mjs",
    "fixtures:check": "node scripts/verify-fixture-provenance.mjs",
    "solana-binding:check": "node scripts/verify-solana-binding-provenance.mjs",
    "test:browser": "npm run build && node test/browser-build.mjs",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "json-canonicalize": "^1.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
